# Used only when running the API directly with npm.
# Docker Compose configures the internal Postgres connection automatically.
DATABASE_URL="postgresql://sprintforge:sprintforge@localhost:5432/sprintforge"
PORT=4000
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN="http://localhost:5173"
JWT_SECRET="replace-with-at-least-32-random-characters"
INITIAL_ADMIN_NAME="SprintForge Admin"
INITIAL_ADMIN_EMAIL="admin@sprintforge.local"
INITIAL_ADMIN_PASSWORD="Admin123!"
SEED_DEMO_DATA="true"
SEED_USER_PASSWORD="SprintForge123!"
