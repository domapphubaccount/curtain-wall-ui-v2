generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  key       String
  seq       Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stories   Story[]
  sprints   Sprint[]
  epics     Epic[]
  members   Member[]
  wbNodes   WBNode[]
  wbEdges   WBEdge[]
  wbStrokes WBStroke[]
  wbGroups  WBGroup[]
}

model Epic {
  id        String  @id @default(cuid())
  name      String
  color     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  stories Story[]

  @@index([projectId])
}

model Member {
  id        String    @id @default(cuid())
  name      String
  role      String
  email     String
  color     String
  invitedAt DateTime?
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  stories Story[]

  @@index([projectId])
}

model Sprint {
  id              String  @id @default(cuid())
  name            String
  goal            String
  startDate       String
  endDate         String
  state           String
  velocity        Int?
  committedPoints Int?
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String

  stories Story[]

  @@index([projectId])
}

model Story {
  id                 String    @id @default(cuid())
  key                String
  title              String
  description        String
  type               String
  status             String
  priority           String
  points             Int?
  acceptanceCriteria String[]
  createdAt          DateTime  @default(now())
  completedAt        DateTime?
  startDate          String?
  dueDate            String?
  dependsOn          String[]

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  epic       Epic?   @relation(fields: [epicId], references: [id], onDelete: SetNull)
  epicId     String?
  assignee   Member? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?
  sprint     Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  sprintId   String?

  wbNodes WBNode[]

  @@index([projectId])
}

model WBGroup {
  id        String  @id @default(cuid())
  name      String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  nodes WBNode[]

  @@index([projectId])
}

model WBNode {
  id         String  @id @default(cuid())
  kind       String
  x          Float
  y          Float
  w          Float
  h          Float
  text       String?
  color      String?
  shape      String?
  fontFamily String?
  bold       Boolean?
  textColor  String?

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  story     Story?   @relation(fields: [storyId], references: [id], onDelete: SetNull)
  storyId   String?
  group     WBGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId   String?

  @@index([projectId])
}

model WBEdge {
  id        String  @id @default(cuid())
  fromId    String
  toId      String
  color     String?
  bend      Float?
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId])
}

model WBStroke {
  id        String   @id @default(cuid())
  color     String
  points    Float[]
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId])
}
