# Used only when running the frontend directly with npm.
# Docker Compose configures this value automatically.
VITE_API_URL="http://localhost:4000"

# Docker Compose authentication bootstrap. Change these values before sharing the system.
JWT_SECRET="replace-with-at-least-32-random-characters"
INITIAL_ADMIN_NAME="SprintForge Admin"
INITIAL_ADMIN_EMAIL="admin@sprintforge.local"
INITIAL_ADMIN_PASSWORD="Admin123!"
SEED_DEMO_DATA="true"
SEED_USER_PASSWORD="SprintForge123!"
